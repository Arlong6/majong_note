default_platform(:ios)

platform :ios do

  desc "Build and upload to TestFlight"
  lane :beta do
    sync_code_signing(
      type: "appstore",
      readonly: true
    )
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and release to App Store"
  lane :release do
    setup_ci   # CI 上建立並解鎖臨時 keychain,供發佈憑證安裝

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_PATH"]),
      in_house: false
    )

    version = (ENV["APP_VERSION"] || "1.0").sub(/^v/, "")
    build = ENV["BUILD_NUMBER"] || number_of_commits.to_s

    # CI 上沒有現成發佈憑證,用 API 金鑰建立/取得 App Store 憑證與 profile
    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: "com.arlong.mahjong", platform: "ios")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "MS5DWUANB6",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.arlong.mahjong",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build}"
    )
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

end
